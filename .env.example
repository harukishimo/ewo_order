APP_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Supabase Connect: direct URL, or session pooler :5432 for IPv4. Used only by build migrations.
SUPABASE_DB_URL=
# Optional CA PEM from Supabase when required for certificate verification.
SUPABASE_DB_CA=
# Optional: existing Supabase Auth user UUID to grant the administrator role at deployment.
ATELIER_ADMIN_USER_ID=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
JEV_MODE=jev
# Optional canonical origin. Leave blank on dynamically named Vercel previews.
APP_URL=
# Only needed if deliberately deploying APP_MODE=demo. Never use demo for real orders.
DEMO_AUTH_SECRET=
